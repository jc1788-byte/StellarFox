# ============================================================================
# Multi-Channel Alerting Configuration
# ============================================================================

# PagerDuty Integration
# Get your API key from https://app.pagerduty.com/api_keys
PAGERDUTY_API_KEY=u+dL_-example_api_key_here

# PagerDuty Integration Key for Events API v2
# Found in your PagerDuty service settings -> Integrations
PAGERDUTY_INTEGRATION_KEY=R1234567890abcdef1234567890abcdef

# Enable/disable PagerDuty integration
PAGERDUTY_ENABLED=true

# ============================================================================
# Alert Notification Channels
# ============================================================================

# Webhook URL for alert notifications
# Used for sending alert events to external systems
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Dashboard URL for alert links
# Included in alert notifications for easy access
DASHBOARD_URL=https://app.stellarfox.dev

# Email configuration (if using email channel)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# EMAIL_FROM=alerts@stellarfox.dev

# SMS configuration (if using SMS channel)
# Twilio example
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Slack configuration (if using Slack channel)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_SIGNING_SECRET=your_signing_secret

# ============================================================================
# Alert Rules and Policies
# ============================================================================

# Default severity for uncategorized alerts
DEFAULT_ALERT_SEVERITY=medium

# Maximum alerts to keep in active list
MAX_ACTIVE_ALERTS=1000

# Alert retention period (in days)
ALERT_RETENTION_DAYS=30

# Enable alert deduplication
ALERT_DEDUPLICATION_ENABLED=true

# Deduplication window (in minutes)
ALERT_DEDUP_WINDOW_MINUTES=5

# ============================================================================
# On-Call Scheduling
# ============================================================================

# Default timezone for new schedules
DEFAULT_SCHEDULE_TIMEZONE=America/New_York

# Enable automatic schedule syncing with PagerDuty
SYNC_SCHEDULES_WITH_PAGERDUTY=true

# Schedule sync interval (in minutes)
SCHEDULE_SYNC_INTERVAL_MINUTES=60

# ============================================================================
# Escalation Policies
# ============================================================================

# Enable automatic escalation
AUTO_ESCALATION_ENABLED=true

# Default escalation delay for level 2 (in minutes)
ESCALATION_LEVEL2_DELAY_MINUTES=15

# Default escalation delay for level 3 (in minutes)
ESCALATION_LEVEL3_DELAY_MINUTES=30

# Maximum escalation levels
MAX_ESCALATION_LEVELS=5

# ============================================================================
# Alert Routing
# ============================================================================

# Enable rule-based alert routing
ALERT_ROUTING_ENABLED=true

# Maximum routing rules
MAX_ROUTING_RULES=100

# Routing evaluation timeout (in milliseconds)
ROUTING_TIMEOUT_MS=5000

# ============================================================================
# Monitoring and Observability
# ============================================================================

# Enable alerting system metrics
ALERTING_METRICS_ENABLED=true

# Metrics reporting interval (in seconds)
METRICS_INTERVAL_SECONDS=60

# Enable detailed alert logging
ALERT_DEBUG_LOGGING=false

# ============================================================================
# Integration Credentials
# ============================================================================

# PagerDuty Service IDs (comma-separated)
# Used for linking alerts to specific services
PAGERDUTY_SERVICE_IDS=PXXXXXX1,PXXXXXX2

# PagerDuty Team IDs (comma-separated)
PAGERDUTY_TEAM_IDS=PTXXXXXX1,PTXXXXXX2

# ============================================================================
# Maintenance and Testing
# ============================================================================

# Enable maintenance mode (suppresses non-critical alerts)
MAINTENANCE_MODE=false

# Maintenance mode end time (ISO 8601)
MAINTENANCE_END_TIME=2024-01-01T23:59:59Z

# Enable test mode (logs alerts instead of sending)
TEST_MODE=false

# ============================================================================
# Advanced Configuration
# ============================================================================

# Redis keys prefix for alerting data
ALERTING_REDIS_PREFIX=alerts:

# Cache TTL for on-call information (in seconds)
ONCALL_CACHE_TTL_SECONDS=3600

# Cache TTL for escalation policies (in seconds)
POLICY_CACHE_TTL_SECONDS=7200

# Batch notification sending (process multiple alerts together)
BATCH_NOTIFICATIONS_ENABLED=true

# Batch size for notification processing
NOTIFICATION_BATCH_SIZE=50

# Batch timeout (in milliseconds)
NOTIFICATION_BATCH_TIMEOUT_MS=5000
